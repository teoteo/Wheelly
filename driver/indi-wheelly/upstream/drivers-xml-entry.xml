<!-- The entry to add inside <devGroup group="Filter Wheels"> of indilib/indi's
     drivers.xml (after the last device of the group). manufacturer="DIY" as
     INDI files the other self-built devices (MyFocuserPro2, ESP32go, AAF2);
     to_indi.py fills the version from WHEELLY_VERSION_MAJOR.MINOR of
     CMakeLists.txt. -->
        <device label="Wheelly" manufacturer="DIY">
            <driver name="Wheelly">@WHEELLY_EXECUTABLE@</driver>
            <version>@WHEELLY_VERSION@</version>
        </device>
